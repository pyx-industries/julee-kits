FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install the kit, which brings julee and the rest of its dependencies
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

# Create a non-root user
RUN useradd --create-home --shell /bin/bash julee
USER julee

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Expose the port the app runs on
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command - start the FastAPI server
CMD ["python", "-m", "uvicorn", "julee_ceap.apps.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
